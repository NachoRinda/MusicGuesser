# Copiá este archivo a .env (no se commitea).
# Clave de la API de Claude para leer las capturas. Alternativa: `ant auth login`.
ANTHROPIC_API_KEY=
# Modelo para leer capturas (por defecto claude-haiku-5-5). Ej.: MG_EXTRACTION_MODEL=claude-opus-5-5
# MG_EXTRACTION_MODEL=
# Para probar sin la API (lee canciones falsas): MG_EXTRACTOR=fake
# MG_EXTRACTOR=fake
# MG_FAKE_DELAY_MS=700
